<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lg.platform.loyalty</groupId>
        <artifactId>lg5-loyalty-ledger</artifactId>
        <version>1.0.0-alpha</version>
    </parent>

    <artifactId>lg5-loyalty-ledger-container</artifactId>

    <properties>
        <start-class>com.lg.platform.loyalty.Application</start-class>
        <testcontainers.docker.client.strategy>org.testcontainers.dockerclient.UnixSocketClientProviderStrategy</testcontainers.docker.client.strategy>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-message-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-logger</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-starter-sleuth</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- tests -->
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-integration-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            TASK-005 (002-api-specifications): contract-test the REST
            ITs against docs/api/openapi.yaml. swagger-request-validator
            is OpenAPI-3.x-aware (despite the name) and integrates as
            a RestAssured Filter — every response body, status code,
            content type and header is validated against the spec on
            top of the existing Hamcrest assertions.
        -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-restassured</artifactId>
            <version>2.44.9</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>maven_central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
    </repositories>
</project>
