<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lg.platform.loyalty</groupId>
        <artifactId>lg5-loyalty-ledger</artifactId>
        <version>1.0.0-alpha</version>
    </parent>

    <artifactId>lg5-loyalty-ledger-support</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-message-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-message-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-container</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <!-- aggregated unit test coverage report -->
                    <execution>
                        <id>aggregate-reports-ut</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>lg5-loyalty-ledger: Coverage of Unit Tests</title>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate-ut</outputDirectory>
                            <dataFileExcludes>
                                <dataFileExclude>**/target/jacoco-it.exec</dataFileExclude>
                            </dataFileExcludes>
                        </configuration>
                    </execution>
                    <!-- aggregated integration test coverage report -->
                    <execution>
                        <id>aggregate-reports-it</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>lg5-loyalty-ledger: Coverage of Integration Tests</title>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate-it</outputDirectory>
                            <dataFileExcludes>
                                <dataFileExclude>**/target/jacoco.exec</dataFileExclude>
                            </dataFileExcludes>
                        </configuration>
                    </execution>
                    <!-- aggregated overall test coverage report -->
                    <execution>
                        <id>aggregate-reports-all</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>lg5-loyalty-ledger: Overall Coverage</title>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate-all</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
