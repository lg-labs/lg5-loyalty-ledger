<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lg.platform.loyalty</groupId>
        <artifactId>lg5-loyalty-ledger</artifactId>
        <version>1.0.0-alpha</version>
    </parent>

    <artifactId>lg5-loyalty-ledger-acceptance-test</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-starter</artifactId>
        </dependency>

        <!-- DB -->
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-data-jpa</artifactId>
        </dependency>
        <!-- Avro -->
        <dependency>
            <groupId>com.lg5.spring.kafka</groupId>
            <artifactId>lg5-spring-kafka-model</artifactId>
        </dependency>
        <!-- Producer -->
        <dependency>
            <groupId>com.lg5.spring.kafka</groupId>
            <artifactId>lg5-spring-kafka-producer</artifactId>
        </dependency>
        <!-- Consumer -->
        <dependency>
            <groupId>com.lg5.spring.kafka</groupId>
            <artifactId>lg5-spring-kafka-consumer</artifactId>
        </dependency>

        <!-- App modules: pulled in so the @SpringBootApplication scans
             every layer (domain, application-service, data-access,
             api, message). This module hosts the ATDD runner; the
             real Lg5LoyaltyLedgerApplication class lives in
             lg5-loyalty-ledger-container. -->
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-container</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-message-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lg.platform.loyalty</groupId>
            <artifactId>lg5-loyalty-ledger-message-model</artifactId>
        </dependency>

        <!-- Test: Cucumber + Lg5TestBootPortNone + Testcontainers come transitively. -->
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-acceptance-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lg5.spring</groupId>
            <artifactId>lg5-spring-integration-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
